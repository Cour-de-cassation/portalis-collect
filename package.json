{
  "name": "portalis-collect",
  "version": "1.0.0",
  "description": "package to collect portalis",
  "main": "dist/server.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "format": "prettier \"src/**/*.ts\" --check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "fix": "eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write",
    "test": "jest --detectOpenHandles -c jest.config.js",
    "start:docker": "docker compose up -d",
    "start:watch": "nodemon --watch 'src/**' --ext 'ts,json' --exec 'npx ts-node src/server.ts'",
    "build": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "axios": "1.21.0",
    "cron": "4.4.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "form-data": "4.0.6",
    "helmet": "8.3.0",
    "html-to-text": "10.0.1",
    "mongodb": "7.7.0",
    "multer": "2.5.0",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/html-to-text": "9.0.4",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/uuid": "11.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
